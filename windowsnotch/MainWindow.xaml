<Window x:Class="windowsnotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="Transparent"/>
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#55FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border
            Background="#E6000000"
            CornerRadius="16"
            Padding="10"
            MouseLeftButtonDown="Window_MouseLeftButtonDown"
            MouseEnter="Widget_MouseEnter"
            MouseLeave="Widget_MouseLeave">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Album art -->
                <Border
                    Grid.Column="0"
                    Width="50"
                    Height="50"
                    CornerRadius="8"
                    Background="#333"
                    VerticalAlignment="Center">
                    <Image x:Name="AlbumArtImage" Stretch="UniformToFill"/>
                </Border>

                <!-- Text -->
                <StackPanel
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="SongTitleText"
                        Text="Song Title"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        x:Name="ArtistText"
                        Text="Artist Name"
                        Foreground="#AAAAAA"
                        FontSize="12"
                        TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Right side container -->
                <Grid
                    Grid.Column="2"
                    Width="104"
                    Height="36"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">

                    <!-- Waveform — behind, not hit testable -->
                    <StackPanel
                        x:Name="WaveformBars"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Opacity="1">
                        <Border x:Name="Bar1" Width="4" Height="10" CornerRadius="2" Background="#AAAAAA" Margin="2,0" VerticalAlignment="Center"/>
                        <Border x:Name="Bar2" Width="4" Height="16" CornerRadius="2" Background="#AAAAAA" Margin="2,0" VerticalAlignment="Center"/>
                        <Border x:Name="Bar3" Width="4" Height="13" CornerRadius="2" Background="#AAAAAA" Margin="2,0" VerticalAlignment="Center"/>
                        <Border x:Name="Bar4" Width="4" Height="18" CornerRadius="2" Background="#AAAAAA" Margin="2,0" VerticalAlignment="Center"/>
                        <Border x:Name="Bar5" Width="4" Height="12" CornerRadius="2" Background="#AAAAAA" Margin="2,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Playback Controls — on top -->
                    <StackPanel
                        x:Name="PlaybackControls"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0">
                        <Button
                            Style="{StaticResource IconButton}"
                            Click="Prev_Click"
                            Content="&#xE892;"
                            ToolTip="Previous"/>
                        <Button
                            Style="{StaticResource IconButton}"
                            Click="PlayPause_Click"
                            Content="&#xE768;"
                            Width="32"
                            Height="32"
                            FontSize="15"
                            Foreground="White"
                            ToolTip="Play / Pause"/>
                        <Button
                            Style="{StaticResource IconButton}"
                            Click="Next_Click"
                            Content="&#xE893;"
                            ToolTip="Next"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>